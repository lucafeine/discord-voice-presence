# Dependencies
node_modules/

# Secrets — ne jamais committer
.env
.env.*
!.env.example

# Données locales du prototype (tokens OAuth, cache d'avatars)
.data/
out/

# Journalisation
*.log
npm-debug.log*

# Sortie de build du plugin Stream Deck
# `**/` est necessaire : un motif contenant un `/` est ancre a la racine du
# depot, donc `*.sdPlugin/bin/` ne matcherait pas un plugin dans un sous-dossier.
**/*.sdPlugin/bin/
**/*.sdPlugin/logs/
*.streamDeckPlugin

# Divers
.DS_Store
Thumbs.db
