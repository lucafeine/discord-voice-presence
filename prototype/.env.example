# Copier ce fichier en `.env` puis remplir les valeurs.
#   copy .env.example .env
#
# Le `.env` est ignore par git (voir .gitignore a la racine) : ne jamais
# committer de secret, et ne jamais le coller dans un chat.

# ---------------------------------------------------------------------------
# Application Discord — https://discord.com/developers/applications
#   New Application -> General Information -> Application ID (= client_id)
#
# Aucun bot n'est necessaire. Aucun client_secret non plus : le flux utilise
# PKCE, qui n'embarque que cet identifiant public.
# ---------------------------------------------------------------------------
DISCORD_CLIENT_ID=

# Scopes OAuth demandes via AUTHORIZE.
#   rpc  -> GET_SELECTED_VOICE_CHANNEL, VOICE_STATE_*, VOICE_CHANNEL_SELECT
#           (VOICE_CHANNEL_SELECT est le seul moyen d'etre notifie instantanement
#            quand tu changes de salon vocal)
#   rpc.voice.read -> suffisant pour lire le vocal, mais sans VOICE_CHANNEL_SELECT
DISCORD_SCOPES=rpc

# ===========================================================================
# A FAIRE UNE SEULE FOIS DANS LE PORTAIL DEVELOPEUR
#
# 1. OAuth2 -> Public Client -> ACTIVER -> Save Changes
#
#    C'est ce reglage qui autorise PKCE, donc l'absence de client_secret.
#    Sans lui, l'echange du code repond `HTTP 401 invalid_client`, ce qui
#    ressemble a tort a une incompatibilite du flux RPC.
#
# 2. OAuth2 -> Redirects -> ajouter une URI -> la placer EN PREMIERE -> Save
#    Par exemple :  http://localhost
#
#    Le flux OAuth2 du RPC REFUSE tout redirect_uri envoye dans la requete
#    ("Redirect URI cannot be used in the RPC OAuth2 Authorization flow"), mais
#    exige qu'une URI soit ENREGISTREE pour avoir une valeur par defaut.
#    Sans enregistrement : "Missing redirect_uri in request".
#
# L'URI n'est jamais utilisee : le code d'autorisation arrive par la socket IPC.
# ===========================================================================
