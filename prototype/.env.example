# Copier ce fichier en `.env` puis remplir les valeurs.
#   copy .env.example .env
#
# Le `.env` est ignore par git (voir .gitignore a la racine) : ne jamais
# committer de secret, et ne jamais le coller dans un chat.

# ---------------------------------------------------------------------------
# Application Discord — https://discord.com/developers/applications
#   New Application -> General Information -> Application ID (= client_id)
#   OAuth2 -> Client Secret
# Aucun bot n'est necessaire, aucun redirect URI n'est requis pour l'IPC.
# ---------------------------------------------------------------------------
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Scopes OAuth demandes via AUTHORIZE.
#   rpc  -> GET_SELECTED_VOICE_CHANNEL, VOICE_STATE_*, VOICE_CHANNEL_SELECT
#           (VOICE_CHANNEL_SELECT est le seul moyen d'etre notifie instantanement
#            quand tu changes de salon vocal)
#   rpc.voice.read -> suffisant pour lire le vocal, mais sans VOICE_CHANNEL_SELECT
DISCORD_SCOPES=rpc

# Note : le flux OAuth2 du RPC Discord refuse les clients publics, donc PKCE.
# Les deux erreurs observees se contredisent :
#   PKCE sans redirect_uri -> 'Missing "redirect_uri" in request'
#   PKCE avec redirect_uri -> 'Redirect URI cannot be used in the RPC OAuth2
#                              Authorization flow'
# Le client_secret est donc obligatoire (c'est ce que fait aussi le plugin
# Discord officiel d'Elgato).
#
# IMPORTANT : il faut aussi enregistrer une URI de redirection de secours dans
# le portail, sans jamais l'envoyer dans la requete :
#   OAuth2 -> Redirects -> ajoute exactement  https://127.0.0.1
#   et place-la en PREMIERE position, puis Save Changes.
# Discord retombe sur la premiere URI enregistree ; le code d'autorisation arrive
# de toute facon par la socket IPC, la redirection n'est jamais suivie.
# Sans cet enregistrement : 'Missing "redirect_uri" in request'.
