{
	"name": "streamdeck-discord-voice-presence",
	"version": "1.0.0",
	"private": true,
	"description": "Display the Discord voice channel participants on the Stream Deck Neo Infobar.",
	"author": "Lucafeine <lucafeine@proton.me>",
	"type": "module",
	"scripts": {
		"build": "rollup -c",
		"assets": "node tools/generate-infobar.ts",
		"icons": "node tools/generate-icons.mjs",
		"locales": "node tools/check-locales.mjs",
		"preview": "node tools/preview-infobar.ts",
		"watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.lucafeine.discord-voice-presence\"",
		"validate": "streamdeck validate com.lucafeine.discord-voice-presence.sdPlugin",
		"link": "streamdeck link com.lucafeine.discord-voice-presence.sdPlugin",
		"pack": "streamdeck pack -f com.lucafeine.discord-voice-presence.sdPlugin",
		"release": "npm run build && npm run assets && npm run icons && npm run locales && npm run validate && npm run pack"
	},
	"dependencies": {
		"@elgato/streamdeck": "^3.0.2"
	},
	"devDependencies": {
		"@elgato/cli": "^1.10.2",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.3.0",
		"@tsconfig/node24": "^24.0.5",
		"@types/node": "^24.0.0",
		"rollup": "^4.64.9",
		"sharp": "^0.35.5",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3"
	}
}
